# PostgreSQL
POSTGRES_DB=predictor_db
POSTGRES_USER=predictor_user
POSTGRES_PASSWORD=changeme_locally
# POSTGRES_HOST_AUTH_METHOD=trust
DEV_MODE=True

# 42 OAuth — get these from api.intra.42.fr > Applications
OAUTH_CLIENT_ID=your_42_client_id
