    {
      "id": "VLZCkixSrdMtuMC1LNwjr",
      "type": "text",
      "x": 693.9260707842782,
      "y": 2957.6682385119184,
      "width": 839.6953125,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 303705116,
      "version": 1141,
      "versionNonce": 1759185572,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780934280316,
      "link": null,
      "locked": false,
      "text": "Daily update:\n- Pull the match data\n- Update matches database\n    compare database and pulled match data\n    ignore played matches\n    collect updated matches (ids, score) to pass it further\n- Update Predictions(updated matches)\n    for match in updated matches:\n\n        find all predictions with this match id\n        predictoin.setup(compare(match.score, prediction.score)\n- Calculate p_score\n    User.update(p_score)\n\nAfter all user p_score updated\n    for User in users\n        User.update(rank)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Daily update:\n- Pull the match data\n- Update matches database\n    compare database and pulled match data\n    ignore played matches\n    collect updated matches (ids, score) to pass it further\n- Update Predictions(updated matches)\n    for match in updated matches:\n\n        find all predictions with this match id\n        predictoin.setup(compare(match.score, prediction.score)\n- Calculate p_score\n    User.update(p_score)\n\nAfter all user p_score updated\n    for User in users\n        User.update(rank)",
      "autoResize": true,
      "lineHeight": 1.25
    },
